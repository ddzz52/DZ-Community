# ==================== 数据库 ====================
DB_ROOT_PASSWORD=ChangeMe_To_A_Strong_Password_2024
DB_NAME=couple

# ==================== JWT 密钥 (至少32位随机字符串) ====================
# 生成方式: openssl rand -base64 48
JWT_SECRET=ChangeMe_To_A_Random_64Char_String_abc123def456ghi789jkl012mno345pqr678

# ==================== 火山引擎 Ark API (豆包大模型) ====================
# 从火山引擎控制台获取: https://console.volcengine.com/ark
VOLCENGINE_ARK_API_KEY=your-ark-api-key-here
VOLCENGINE_ARK_ENDPOINT_ID=your-endpoint-id-here

# ==================== 部署配置 ====================
# 服务器公网IP或域名
DOMAIN=your-server-ip-or-domain
